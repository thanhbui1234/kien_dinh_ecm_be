  facebookUrl          String?                    @default("https://www.facebook.com/ThanhBangNamDinh")
  youtubeUrl           String?                    @default("https://www.youtube.com/@congtythanhbang1735")
  instagramUrl         String?
  phone                String?                    @default("0943676869")
  email                String?                    @default("maygachbetongtb@gmail.com")
  address              String?                    @default("Công Ty Cổ Phần Thanh Bằng, Xuân Trường, Ninh Bình 420000, Việt Nam")
  salesPhone           String?                    @default("0943.67.68.69")
  feedbackPhone        String?                    @default("0914 161 122")
  warrantyPhone        String?                    @default("0912 01 77 55")
  customerSupportTitle String?                    @default("HỖ TRỢ KHÁCH HÀNG")
  customerSupportLinks Json?
