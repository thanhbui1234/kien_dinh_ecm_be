  translations         FooterSettingTranslation[]
}

model FooterSettingTranslation {
  id                   String        @id @default(uuid())
  settingId            String
  lang                 Language      @default(VI)
  introText            String
  address              String?
  customerSupportTitle String?
  customerSupportLinks Json?
