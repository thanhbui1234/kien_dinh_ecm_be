generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  ADMIN
}

enum Language {
  VI
  EN
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  password     String
  fullName     String
  role         Role     @default(ADMIN)
  isLocked     Boolean  @default(false)
  createdAt    DateTime @default(now())
  refreshToken String?
}

model Category {
  id              String                @id @default(uuid())
  name            String
  slug            String                @unique
  orderIndex      Int                   @default(0)
  status          Boolean               @default(true)
  parentId        String?
  imageUrl        String?
  parent          Category?             @relation("CategoryToCategory", fields: [parentId], references: [id], onDelete: Restrict)
  subCategories   Category[]            @relation("CategoryToCategory")
  products        Product[]
  projectMappings ProjectCategory[]
  translations    CategoryTranslation[]

  @@index([parentId])
  @@index([orderIndex])
}

model CategoryTranslation {
  id         String   @id @default(uuid())
  categoryId String
  lang       Language @default(VI)
  name       String
  slug       String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, lang])
  @@unique([lang, slug])
  @@index([lang, slug])
}

model Product {
  id              String               @id @default(uuid())
  name            String
  slug            String               @unique
  price           Float?
  thumbnailUrl    String
  isFeatured      Boolean              @default(false)
  status          Boolean              @default(true)
  categoryId      String
  createdAt       DateTime             @default(now())
  parentId        String?
  viewCount       Int                  @default(0)
  contactRequests ContactRequest[]
  category        Category             @relation(fields: [categoryId], references: [id])
  parent          Product?             @relation("ProductVariants", fields: [parentId], references: [id], onDelete: Restrict)
  variants        Product[]            @relation("ProductVariants")
  detail          ProductDetail?
  images          ProductImage[]
  projectMappings ProjectProduct[]
  translations    ProductTranslation[]

  @@index([name])
  @@index([categoryId, status])
  @@index([isFeatured, status])
}

model ProductTranslation {
  id             String   @id @default(uuid())
  productId      String
  lang           Language @default(VI)
  name           String
  slug           String
  contentDetail  String?  @db.Text
  specifications Json?
  features       Json?
  seoTitle       String?
  seoDescription String?
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, lang])
  @@unique([lang, slug])
  @@index([lang, slug])
}

model ProductDetail {
  productId      String   @id
  contentDetail  String
  specifications Json
  seoMeta        Json?
  features       Json?
  videoUrls      String[] @default([])
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductImage {
  id         String  @id @default(uuid())
  imageUrl   String
  isMain     Boolean @default(false)
  orderIndex Int     @default(0)
  productId  String
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Project {
  id          String               @id @default(uuid())
  name        String
  slug        String               @unique
  description String               @db.VarChar(500)
  coverImage  String
  status      Boolean              @default(true)
  createdAt   DateTime             @default(now())
  isFeatured  Boolean              @default(false)
  categories  ProjectCategory[]
  detail      ProjectDetail?
  products    ProjectProduct[]
  translations ProjectTranslation[]

  @@index([status, createdAt(sort: Desc)])
  @@index([isFeatured, status])
}

model ProjectTranslation {
  id            String   @id @default(uuid())
  projectId     String
  lang          Language @default(VI)
  name          String
  slug          String
  description   String   @db.VarChar(500)
  contentDetail String?  @db.Text
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, lang])
  @@unique([lang, slug])
  @@index([lang, slug])
}

model ProjectDetail {
  projectId     String   @id
  contentDetail String
  images        String[] @default([])
  videoUrls     String[] @default([])
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProjectProduct {
  projectId String
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, productId])
}

model ProjectCategory {
  projectId  String
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, categoryId])
}

model ContactRequest {
  id              String       @id @default(uuid())
  fullName        String
  phoneNumber     String
  email           String?
  message         String
  status          String       @default("PENDING")
  adminNote       String?
  targetProductId String?
  targetJobId     String?
  createdAt       DateTime     @default(now())
  priority        LeadPriority @default(MEDIUM)
  product         Product?     @relation(fields: [targetProductId], references: [id])
  job             JobPost?     @relation(fields: [targetJobId], references: [id])

  @@index([status, createdAt(sort: Desc)])
}

model JobPost {
  id              String               @id @default(uuid())
  title           String
  slug            String               @unique
  salary          String               @default("Cạnh tranh")
  status          Boolean              @default(true)
  createdAt       DateTime             @default(now())
  detail          JobPostDetail?
  contactRequests ContactRequest[]
  translations    JobPostTranslation[]

  @@index([status, createdAt(sort: Desc)])
}

model JobPostTranslation {
  id       String   @id @default(uuid())
  jobId    String
  lang     Language @default(VI)
  title    String
  slug     String
  salary   String   @default("Cạnh tranh")
  sections Json?
  job      JobPost  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, lang])
  @@unique([lang, slug])
  @@index([lang, slug])
}

model JobPostDetail {
  jobId     String   @unique
  createdAt DateTime @default(now())
  id        String   @id @default(cuid())
  sections  Json
  updatedAt DateTime @updatedAt
  job       JobPost  @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

model CompanyInfo {
  id           String                   @id @default(uuid())
  label        String
  value        String
  imageUrl     String?
  orderIndex   Int                      @default(0)
  translations CompanyInfoTranslation[]

  @@index([orderIndex])
}

model CompanyInfoTranslation {
  id            String      @id @default(uuid())
  companyInfoId String
  lang          Language    @default(VI)
  label         String
  value         String
  companyInfo   CompanyInfo @relation(fields: [companyInfoId], references: [id], onDelete: Cascade)

  @@unique([companyInfoId, lang])
  @@index([lang])
}

model Facility {
  id           String                @id @default(uuid())
  country      String
  name         String
  address      String
  phone        String
  imageUrl     String?
  orderIndex   Int                   @default(0)
  translations FacilityTranslation[]

  @@index([orderIndex])
}

model FacilityTranslation {
  id         String   @id @default(uuid())
  facilityId String
  lang       Language @default(VI)
  name       String
  country    String
  address    String
  facility   Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@unique([facilityId, lang])
  @@index([lang])
}

model SystemSetting {
  id    String @id @default(uuid())
  key   String @unique
  value String
}

model CompanySlogan {
  id           String                    @id @default(uuid())
  title        String
  icon         String
  orderIndex   Int                       @default(0)
  description  String?
  translations CompanySloganTranslation[]

  @@index([orderIndex])
}

model CompanySloganTranslation {
  id          String        @id @default(uuid())
  sloganId    String
  lang        Language      @default(VI)
  title       String
  description String?
  slogan      CompanySlogan @relation(fields: [sloganId], references: [id], onDelete: Cascade)

  @@unique([sloganId, lang])
  @@index([lang])
}

model Banner {
  id           String                @id @default(uuid())
  imageUrl     String
  orderIndex   Int                   @default(0)
  status       Boolean               @default(true)
  createdAt    DateTime              @default(now())
  description  String?
  link         String?
  title        String?
  translations BannerTranslation[]

  @@index([status, orderIndex])
}

model BannerTranslation {
  id          String   @id @default(uuid())
  bannerId    String
  lang        Language @default(VI)
  title       String?
  description String?
  banner      Banner   @relation(fields: [bannerId], references: [id], onDelete: Cascade)

  @@unique([bannerId, lang])
  @@index([lang])
}

model CompanyProfile {
  id           String                       @id @default("singleton")
  introHtml    String                       @default("")
  thumbnailUrl String?
  translations CompanyProfileTranslation[]
}

model CompanyProfileTranslation {
  id        String         @id @default(uuid())
  profileId String
  lang      Language       @default(VI)
  introHtml String         @db.Text
  profile   CompanyProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, lang])
  @@index([lang])
}

model CompanyHistoryEvent {
  id           String                          @id @default(uuid())
  period       String
  year         String
  text         String
  imageUrl     String?
  orderIndex   Int                             @default(0)
  createdAt    DateTime                        @default(now())
  updatedAt    DateTime                        @updatedAt
  translations CompanyHistoryEventTranslation[]

  @@index([period, orderIndex])
}

model CompanyHistoryEventTranslation {
  id      String              @id @default(uuid())
  eventId String
  lang    Language            @default(VI)
  period  String
  text    String
  event   CompanyHistoryEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, lang])
  @@index([lang])
}

model CompanyLocation {
  id            String                       @id @default(uuid())
  title         String
  addressLabel  String
  address       String
  directionsUrl String?
  mapUrl        String?
  orderIndex    Int                          @default(0)
  createdAt     DateTime                     @default(now())
  updatedAt     DateTime                     @updatedAt
  translations  CompanyLocationTranslation[]

  @@index([orderIndex])
}

model CompanyLocationTranslation {
  id           String          @id @default(uuid())
  locationId   String
  lang         Language        @default(VI)
  title        String
  addressLabel String
  address      String
  location     CompanyLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([locationId, lang])
  @@index([lang])
}

enum LeadPriority {
  HIGH
  MEDIUM
  LOW
}

model ContactSetting {
  id           String                        @id @default("singleton")
  title        String                        @default("Liên hệ với chúng tôi")
  description  String                        @default("Chúng tôi luôn sẵn sàng lắng nghe và giải đáp mọi thắc mắc của bạn về sản phẩm và dịch vụ. Hãy để lại thông tin, đội ngũ tư vấn sẽ liên hệ với bạn trong thời gian sớm nhất.")
  hotline      String                        @default("0374 864 110")
  zalo         String                        @default("0374 864 110")
  email        String                        @default("info@kiendinhecm.com")
  address      String?
  workingHours String?
  mapUrl       String?
  updatedAt    DateTime                      @updatedAt
  translations ContactSettingTranslation[]
}

model ContactSettingTranslation {
  id           String         @id @default(uuid())
  settingId    String
  lang         Language       @default(VI)
  title        String
  description  String
  address      String?
  workingHours String?
  setting      ContactSetting @relation(fields: [settingId], references: [id], onDelete: Cascade)

  @@unique([settingId, lang])
  @@index([lang])
}

model FooterSetting {
